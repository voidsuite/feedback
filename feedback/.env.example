# Void Feedback — environment variables (copy to .env)

# --- VoidAuth (OAuth) ---
VOIDAUTH_URL=https://auth.stwupid.tech
VOIDFEEDBACK_CLIENT_ID=voidfeedback
# In dev this is generated by the VoidAuth seed (set VOIDFEEDBACK_CLIENT_SECRET there
# to pin it). In prod, use the secret issued by VoidAuth for the voidfeedback client.
VOIDFEEDBACK_CLIENT_SECRET=

# --- App ---
APP_URL=http://localhost:5179
PUBLIC_URL=http://localhost:5179
PORT=3009
# Comma-separated allowed CORS origins (browser includes). Usually just APP_URL.
ALLOWED_ORIGINS=http://localhost:5179
# Where SQLite + uploads live.
DATA_DIR=./data

# --- Email notifications (optional) ---
# Leave blank to disable the email notify source.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Void Feedback <noreply@stwupid.tech>

# --- Client build (optional; same-origin in production, so usually blank) ---
# VITE_API_URL=
# VITE_FEEDBACK_URL=http://localhost:5179
