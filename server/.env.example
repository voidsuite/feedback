# Server Configuration
PORT=3001
# Bind address. Keep as 127.0.0.1 so the API is only reachable through the
# reverse proxy (nginx) which serves the official frontend and OAuth endpoints.
HOST=127.0.0.1
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=voidauth
DB_PASSWORD=your_secure_password_here
DB_NAME=voidauth

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_min_32_chars_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth Configuration
OAUTH_CODE_EXPIRES_IN=600
OAUTH_TOKEN_EXPIRES_IN=3600

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Internal API key. Authorises server-to-server calls to internal-only routes
# (e.g. via nginx: proxy_set_header X-Internal-Key <key>). Generate with:
#   openssl rand -hex 32
INTERNAL_API_KEY=your_internal_api_key_hex

# Encryption
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_32_byte_encryption_key_base64_encoded_here
