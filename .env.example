# ------------------------------------------------------------------
# voidfeedback — Void Feedback  ·  environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# --- Server (Bun + Hono gateway) ---
# Where VoidAuth lives. Prod is https://auth.stwupid.tech
VOIDAUTH_URL=https://auth.stwupid.tech

# OAuth client registered with VoidAuth for voidfeedback (ask the voidsuite
# admin to create it: scopes "openid profile email", redirect
# APP_URL/oauth/callback). client_id is public; client_secret stays
# server-side only.
VOIDFEEDBACK_CLIENT_ID=voidfeedback
VOIDFEEDBACK_CLIENT_SECRET=

# Public URL of this app (used for OAuth redirect + CORS + secure cookies).
APP_URL=http://localhost:5179

# Port the gateway server listens on.
PORT=3009

# Comma-separated allowlist for CORS (optional; defaults to APP_URL).
ALLOWED_ORIGINS=

# Directory where the SQLite database and uploaded files live.
DATA_DIR=./data

# SMTP configuration for notification emails (optional).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Void Feedback <noreply@stwupid.tech>

# Public base URL used in notification links/emails (optional; defaults to APP_URL).
PUBLIC_URL=

# --- Client (Vite build) ---
# "backend"  → auth via the voidfeedback gateway server (recommended, secure).
# "browser"  → auth directly with @voidauth/client PKCE (tokens in browser).
VITE_AUTH_MODE=backend

# Where the client talks to the gateway (same origin by default).
VITE_API_URL=

# Public base URL of this feedback app (features like public roadmap links).
VITE_FEEDBACK_URL=

# VoidAuth client id used in browser SDK mode (same value as VOIDFEEDBACK_CLIENT_ID).
VITE_VOIDAUTH_CLIENT_ID=voidfeedback
VITE_VOIDAUTH_ISSUER=https://auth.stwupid.tech
