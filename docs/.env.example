# ------------------------------------------------------------------
# docs — Void Docs  ·  environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The app works fully without VoidAuth (offline/local mode); these
# settings only enable cloud sync, real-time collaboration and
# "Sign in with VoidAuth".
# ------------------------------------------------------------------

# --- Server (Bun + Hono gateway) ---
# Where VoidAuth lives. Prod is https://auth.stwupid.tech
VOIDAUTH_URL=https://auth.stwupid.tech

# OAuth client registered with VoidAuth for docs (ask the voidsuite
# admin to create it: scopes "openid profile email", redirect
# APP_URL/oauth/callback). client_id is public; client_secret stays
# server-side only.
VDOCS_CLIENT_ID=
VDOCS_CLIENT_SECRET=

# Public URL of this app (used for OAuth redirect + CORS + secure cookies).
APP_URL=http://localhost:5176

# Port the gateway server listens on.
PORT=3005

# Used to encrypt the vault-key escrow at rest (server/data/vdocs.db).
# If left empty the server generates a stable secret on first boot and
# stores it inside the same database. Never share it.
SESSION_SECRET=

# Comma-separated allowlist for CORS (optional; defaults to APP_URL).
ALLOWED_ORIGINS=

# --- Client (Vite build) ---
# "backend"  → auth via the docs gateway server (recommended, secure).
# "browser"  → auth directly with @voidauth/client PKCE (tokens in browser).
# "offline"  → no VoidAuth at all; local-only mode (single device).
VITE_AUTH_MODE=backend

# Where the client talks to the gateway (same origin by default).
VITE_API_URL=

# VoidAuth client id used in browser SDK mode (same value as VDOCS_CLIENT_ID).
VITE_VOIDAUTH_CLIENT_ID=docs
VITE_VOIDAUTH_ISSUER=https://auth.stwupid.tech
