# ------------------------------------------------------------------
# m3il — Void Mail  ·  environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The app works fully without VoidAuth (offline/local mode); these
# settings only enable cloud sync + "Sign in with VoidAuth".
# ------------------------------------------------------------------

# --- Server (Bun + Hono gateway) ---
# Where VoidAuth lives. Prod is https://auth.stwupid.tech
VOIDAUTH_URL=https://auth.stwupid.tech

# OAuth client registered with VoidAuth for m3il (ask the voidsuite admin
# to create it: scopes "openid profile email", redirect APP_URL/oauth/callback).
# client_id is public; client_secret stays server-side only.
M3IL_CLIENT_ID=m3il
M3IL_CLIENT_SECRET=

# Public URL of this app (used for OAuth redirect + CORS + secure cookies).
APP_URL=http://localhost:5174

# Port the gateway server listens on.
PORT=3003

# Reserved for future cookie signing. Sessions are opaque random ids stored
# server-side (in-memory); no secret is required to run. Keep it unset unless
# you know you need it.
SESSION_SECRET=

# Comma-separated allowlist for mail-relay rate limiting / CORS (optional).
ALLOWED_ORIGINS=

# --- Client (Vite build) ---
# "backend"  → auth via the m3il gateway server (recommended, secure).
# "browser"  → auth directly with @voidauth/client PKCE (tokens in browser).
# "offline"  → no VoidAuth at all; local-only mode.
VITE_AUTH_MODE=backend

# Where the client talks to the gateway (same origin by default).
VITE_API_URL=

# VoidAuth client id used in browser SDK mode (same value as M3IL_CLIENT_ID).
VITE_VOIDAUTH_CLIENT_ID=m3il
VITE_VOIDAUTH_ISSUER=https://auth.stwupid.tech
