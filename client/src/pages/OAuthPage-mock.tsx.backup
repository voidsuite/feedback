import { useEffect, useMemo, useState } from "react"
import { Link, useNavigate, useSearchParams } from "react-router"
import { useAuth } from "@/contexts/auth"
import { Button } from "@/components/ui/button"
import { Separator } from "@/components/ui/separator"
import { VoidLogo } from "@/components/VoidLogo"
import {
  MOCK_APPS,
  SCOPE_LABELS,
  generateCode,
  connectApp,
} from "@/lib/auth"

export function OAuthPage() {
  const { user } = useAuth()
  const navigate = useNavigate()
  const [params] = useSearchParams()
  const [loading, setLoading] = useState(false)

  const clientId = params.get("client_id")
  const redirectUri = params.get("redirect_uri")
  const scope = params.get("scope") ?? "profile"
  const state = params.get("state") ?? ""
  const scopes = scope
    .split(",")
    .map((s) => s.trim())
    .filter(Boolean)

  // Derive app + error from URL params without useState/useEffect
  const { app, error } = useMemo(() => {
    if (!clientId) return { app: null, error: "Missing client_id parameter." }
    const found = MOCK_APPS[clientId]
    if (!found) return { app: null, error: `Unknown application: "${clientId}"` }
    if (!redirectUri) return { app: null, error: "Missing redirect_uri parameter." }
    return { app: found, error: "" }
  }, [clientId, redirectUri])

  useEffect(() => {
    if (app && !user) {
      const returnTo = `/oauth?${params.toString()}`
      void navigate(`/login?redirect=${encodeURIComponent(returnTo)}`)
    }
  }, [app, user, navigate, params])

  function handleAuthorize() {
    if (!user || !app || !redirectUri) return
    setLoading(true)
    connectApp(user.id, app, scopes)
    const code = generateCode()
    void navigate(
      `/oauth/callback?code=${code}&state=${state}&app=${encodeURIComponent(app.name)}&redirect_uri=${encodeURIComponent(redirectUri)}`,
    )
  }

  function handleCancel() {
    if (!redirectUri || !app) {
      void navigate("/dashboard")
      return
    }
    void navigate(
      `/oauth/callback?error=access_denied&state=${state}&app=${encodeURIComponent(app.name)}&redirect_uri=${encodeURIComponent(redirectUri)}`,
    )
  }

  if (error) {
    return (
      <div className="flex min-h-svh items-center justify-center p-6">
        <div className="w-full max-w-xs space-y-6 text-center">
          <VoidLogo size="lg" className="justify-center" />
          <div className="space-y-2">
            <h1 className="text-lg font-semibold">Invalid request</h1>
            <p className="text-sm text-muted-foreground">{error}</p>
          </div>
          <Button variant="outline" className="w-full" asChild>
            <Link to="/dashboard">Go to dashboard</Link>
          </Button>
        </div>
      </div>
    )
  }

  if (!app || !user) return null

  return (
    <div className="flex min-h-svh items-center justify-center p-6">
      <div className="w-full max-w-sm space-y-6">
        {/* Top logo */}
        <div className="flex justify-center">
          <VoidLogo />
        </div>

        {/* App identity */}
        <div className="space-y-1.5 text-center">
          <div className="flex justify-center">
            <div className="flex size-12 items-center justify-center rounded-2xl border border-border bg-card text-lg font-bold">
              {app.name.charAt(0)}
            </div>
          </div>
          <h1 className="text-xl font-semibold">{app.name}</h1>
          <p className="text-sm text-muted-foreground">
            is requesting access to your Void account
          </p>
        </div>

        <Separator />

        {/* Signed in as */}
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="flex size-8 items-center justify-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">
              {user.name.charAt(0).toUpperCase()}
            </div>
            <div className="leading-tight">
              <p className="text-sm font-medium">{user.name}</p>
              <p className="text-xs text-muted-foreground">{user.email}</p>
            </div>
          </div>
          <Link
            to={`/login?redirect=${encodeURIComponent(`/oauth?${params.toString()}`)}`}
            className="text-xs text-muted-foreground underline-offset-4 hover:underline"
          >
            Switch
          </Link>
        </div>

        <Separator />

        {/* Permissions */}
        <div className="space-y-3">
          <p className="text-xs font-medium tracking-wide text-muted-foreground uppercase">
            This app will be able to
          </p>
          <ul className="space-y-2.5">
            {scopes.map((s) => (
              <li key={s} className="flex items-center gap-3 text-sm">
                <span className="flex size-4 shrink-0 items-center justify-center rounded-full bg-primary/15 text-primary">
                  <svg
                    viewBox="0 0 12 12"
                    className="size-2.5"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="2"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                  >
                    <polyline points="2,6 4.5,8.5 10,3" />
                  </svg>
                </span>
                {SCOPE_LABELS[s] ?? s}
              </li>
            ))}
          </ul>
        </div>

        {/* Actions */}
        <div className="flex gap-3">
          <Button
            variant="outline"
            className="flex-1"
            onClick={handleCancel}
            disabled={loading}
          >
            Cancel
          </Button>
          <Button
            className="flex-1"
            onClick={handleAuthorize}
            disabled={loading}
          >
            {loading ? "Authorizing…" : "Authorize"}
          </Button>
        </div>

        <p className="text-center text-xs text-muted-foreground">
          By authorizing, you agree to share your{" "}
          <span className="text-foreground">{scopes.join(", ")}</span> with{" "}
          {app.name}.
        </p>
      </div>
    </div>
  )
}
