// Mock auth implementation using localStorage.
// In production, all of this would be server-side with hashed passwords and real JWTs.

export interface User {
  id: string
  email: string
  name: string
  createdAt: string
}

export interface OAuthApp {
  id: string
  name: string
  redirectUri: string
  scopes: string[]
}

export interface ConnectedApp {
  appId: string
  appName: string
  authorizedAt: string
  scopes: string[]
}

const USERS_KEY = "va_users"
const SESSION_KEY = "va_session"

// Pre-registered OAuth apps for demo purposes
export const MOCK_APPS: Record<string, OAuthApp> = {
  "demo-app": {
    id: "demo-app",
    name: "Demo App",
    redirectUri: "http://localhost:3001/callback",
    scopes: ["profile", "email"],
  },
  "my-project": {
    id: "my-project",
    name: "My Project",
    redirectUri: "https://myproject.com/auth/callback",
    scopes: ["profile"],
  },
  "acme-corp": {
    id: "acme-corp",
    name: "Acme Corp",
    redirectUri: "https://acme.example.com/oauth/callback",
    scopes: ["profile", "email"],
  },
}

export const SCOPE_LABELS: Record<string, string> = {
  profile: "View your name and profile",
  email: "View your email address",
  read: "Read your account data",
  write: "Modify your account data",
}

function generateId(): string {
  return Math.random().toString(36).slice(2) + Date.now().toString(36)
}

export function generateCode(): string {
  const bytes = crypto.getRandomValues(new Uint8Array(20))
  return Array.from(bytes)
    .map((b) => b.toString(16).padStart(2, "0"))
    .join("")
}

export function generateToken(): string {
  const bytes = crypto.getRandomValues(new Uint8Array(32))
  return (
    "va_" +
    Array.from(bytes)
      .map((b) => b.toString(16).padStart(2, "0"))
      .join("")
  )
}

type StoredUser = User & { password: string }

function getStoredUsers(): Record<string, StoredUser> {
  try {
    return JSON.parse(localStorage.getItem(USERS_KEY) ?? "{}") as Record<string, StoredUser>
  } catch {
    return {}
  }
}

function toSafeUser(u: StoredUser): User {
  return { id: u.id, email: u.email, name: u.name, createdAt: u.createdAt }
}

export function getCurrentUser(): User | null {
  try {
    const raw = localStorage.getItem(SESSION_KEY)
    return raw ? (JSON.parse(raw) as User) : null
  } catch {
    return null
  }
}

export function register(
  name: string,
  email: string,
  password: string,
): { user: User } | { error: string } {
  const users = getStoredUsers()
  const exists = Object.values(users).some((u) => u.email === email)
  if (exists) return { error: "An account with this email already exists." }

  const user: StoredUser = {
    id: generateId(),
    email,
    name,
    password,
    createdAt: new Date().toISOString(),
  }

  users[user.id] = user
  localStorage.setItem(USERS_KEY, JSON.stringify(users))

  const safe = toSafeUser(user)
  localStorage.setItem(SESSION_KEY, JSON.stringify(safe))
  return { user: safe }
}

export function login(
  email: string,
  password: string,
): { user: User } | { error: string } {
  const users = getStoredUsers()
  const user = Object.values(users).find((u) => u.email === email)
  if (!user || user.password !== password)
    return { error: "Invalid email or password." }

  const safe = toSafeUser(user)
  localStorage.setItem(SESSION_KEY, JSON.stringify(safe))
  return { user: safe }
}

export function logout(): void {
  localStorage.removeItem(SESSION_KEY)
}

function connectedAppsKey(userId: string): string {
  return `va_apps_${userId}`
}

export function getConnectedApps(userId: string): ConnectedApp[] {
  try {
    const raw = localStorage.getItem(connectedAppsKey(userId))
    return raw ? (JSON.parse(raw) as ConnectedApp[]) : []
  } catch {
    return []
  }
}

export function connectApp(userId: string, app: OAuthApp, scopes: string[]): void {
  const apps = getConnectedApps(userId)
  const idx = apps.findIndex((a) => a.appId === app.id)
  const entry: ConnectedApp = {
    appId: app.id,
    appName: app.name,
    authorizedAt: new Date().toISOString(),
    scopes,
  }
  if (idx >= 0) apps[idx] = entry
  else apps.push(entry)
  localStorage.setItem(connectedAppsKey(userId), JSON.stringify(apps))
}

export function revokeApp(userId: string, appId: string): void {
  const apps = getConnectedApps(userId).filter((a) => a.appId !== appId)
  localStorage.setItem(connectedAppsKey(userId), JSON.stringify(apps))
}
